<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- StangaNetLib foundation — align with published 1.0.0 packages -->
    <PackageVersion Include="StangaNetLib.Concurrency" Version="1.0.0" />
    <PackageVersion Include="StangaNetLib.Resilience" Version="1.0.0" />
    <!-- Runtime dependencies — align with lowest TFM (net8) for dual-targeting -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <!-- 2.8.x keeps Microsoft.Extensions.* on 8.x (3.x pulls Logging.Abstractions 10+) -->
    <PackageVersion Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test infrastructure -->
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>

